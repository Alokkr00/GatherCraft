# Database Connection (Neon Cloud PostgreSQL recommended for multi-device cross-browser sync)
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# Google Gemini API Key for AI features (Purpose refinement, Live coaching, Thank-you note drafting)
GEMINI_API_KEY=""

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare R2 Storage (Optional in dev — defaults to local /api/mock-upload)
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="gathercraft-media"
CLOUDFLARE_R2_PUBLIC_DOMAIN=""
