generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String?
  image        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ownedEvents    Event[]        @relation("Owner")
  coHostedEvents Event[]        @relation("CoHosts")
  assignedSteps  TimelineItem[]
  assignedTasks  Task[]
}

model Event {
  id               String   @id @default(cuid())
  inviteToken      String   @unique
  title            String
  ownerId          String
  owner            User     @relation("Owner", fields: [ownerId], references: [id])
  coHosts          User[]   @relation("CoHosts")
  templateId       String?
  status           String   @default("planning") // planning | live | completed
  
  // Purpose
  rawPurpose       String?
  purposeStatement String?
  isPurposePrivate Boolean  @default(false)
  
  // Date & Logistics
  date             String   // YYYY-MM-DD
  startTime        String   // HH:mm
  endTime          String   // HH:mm
  timezone         String   @default("UTC")
  locationName     String?
  address          String?
  locationNotes    String?
  isLocationTBD    Boolean  @default(false)
  
  // Visuals & Budget
  capacity         Int      @default(20)
  totalBudget      Float    @default(0)
  currency         String   @default("USD")
  coverAssetUrl    String?
  themeColor       String?  @default("from-amber-500 to-rose-600")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  guests           Guest[]
  timeline         TimelineItem[]
  tasks            Task[]
  budget           BudgetItem[]
  shopping         ShoppingItem[]
  retrospective    Retrospective?
  mediaAssets      MediaAsset[]
  chatMessages     ChatMessage[]
  memoryCapsule    MemoryCapsule?
}

model Guest {
  id              String    @id @default(cuid())
  eventId         String
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String?
  role            String    @default("guest")
  rsvpStatus      String    @default("pending") // yes | no | maybe | waitlist | pending
  plusOnesAllowed Int       @default(0)
  plusOnesActual  Int       @default(0)
  dietary         String?
  accessibility   String?
  notes           String?
  checkInAt       DateTime?
  inviteToken     String?   @unique
  consentTier     ConsentSpectrum @default(OPEN)
  consentUpdatedAt DateTime?
  mediaAssets     MediaAsset[]
  chatMessages    ChatMessage[]
  updatedAt       DateTime  @updatedAt

  @@index([eventId])
}

model TimelineItem {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  offsetMinutes   Int      @default(0)
  durationMinutes Int      @default(30)
  isCompleted     Boolean  @default(false)
  assigneeName    String?
  assigneeId      String?
  assignee        User?    @relation(fields: [assigneeId], references: [id])
  order           Int      @default(0)
  mediaAssets     MediaAsset[]
  updatedAt       DateTime @updatedAt

  @@index([eventId])
}

model Task {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  category    String?
  priority    String   @default("medium")
  status      String   @default("todo") // todo | in-progress | done
  assigneeId  String?
  assignee    User?    @relation(fields: [assigneeId], references: [id])
  updatedAt   DateTime @updatedAt

  @@index([eventId])
}

model BudgetItem {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  category      String?
  plannedAmount Float    @default(0)
  actualAmount  Float?
  notes         String?
  updatedAt     DateTime @updatedAt

  @@index([eventId])
}

model ShoppingItem {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int      @default(1)
  unit      String?
  category  String?
  isBought  Boolean  @default(false)

  @@index([eventId])
}

model Retrospective {
  id            String    @id @default(cuid())
  eventId       String    @unique
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rating        Int?
  whatWorked    String?
  whatToImprove String?
  completedAt   DateTime?
}

// ==========================================
// GROWTH ENGINE MODELS & ENUMS
// ==========================================

enum ConsentSpectrum {
  OPEN
  CIRCLE_ONLY
  GHOST_MODE
}

enum MediaTier {
  HOST_VAULT
  SHARED_ALBUM
  PUBLIC_REEL
}

enum MediaStatus {
  PENDING_UPLOAD
  READY
  FLAGGED_HIDDEN
}

enum ChatPhase {
  PLANNING
  LIVE
  GRATITUDE
  ARCHIVED
}

model MediaAsset {
  id              String         @id @default(cuid())
  eventId         String
  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploaderGuestId String?
  uploaderGuest   Guest?         @relation(fields: [uploaderGuestId], references: [id], onDelete: SetNull)
  uploaderName    String
  
  storageKey      String         @unique
  cdnUrl          String
  thumbnailUrl    String?
  blurHash        String?
  
  mimeType        String
  sizeBytes       Int
  width           Int?
  height          Int?
  
  purposeTag      String?
  caption         String?
  visibilityTier  MediaTier      @default(SHARED_ALBUM)
  status          MediaStatus    @default(PENDING_UPLOAD)
  
  isFlaggedHidden Boolean        @default(false)
  timelineItemId  String?
  timelineItem    TimelineItem?  @relation(fields: [timelineItemId], references: [id], onDelete: SetNull)
  
  // Moderation & Audit Trail
  moderatedAt     DateTime?
  moderationReason String?
  selfRemovedAt   DateTime?
  deletedAt       DateTime?
  expiresAt       DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([eventId, visibilityTier])
  @@index([eventId, status])
  @@index([expiresAt])
}

model ChatMessage {
  id              String         @id @default(cuid())
  eventId         String
  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  senderGuestId   String?
  senderGuest     Guest?         @relation(fields: [senderGuestId], references: [id], onDelete: SetNull)
  senderName      String
  senderRole      String         @default("guest") // host | co-host | guest
  
  content         String
  phase           ChatPhase      @default(PLANNING)
  isBroadcast     Boolean        @default(false)
  isPinned        Boolean        @default(false)
  
  // Rate limiting / Abuse prevention
  clientIpHash    String?
  flagCount       Int            @default(0)
  isMuted         Boolean        @default(false)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  @@index([eventId, phase, createdAt])
}

model MemoryCapsule {
  id              String         @id @default(cuid())
  eventId         String         @unique
  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  capsuleToken    String         @unique @default(cuid())
  isPublished     Boolean        @default(false)
  heroQuote       String?
  summaryStory    String?
  featuredMedia   Json?          // array of media asset IDs
  
  viewsCount      Int            @default(0)
  cloneCount      Int            @default(0)
  uniqueReferrers Json?          // analytics map: { [source]: count }
  lastViewedAt    DateTime?
  
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}
