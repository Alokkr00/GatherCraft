rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isHost(eventId) {
      let ev = get(/databases/$(database)/documents/events/$(eventId)).data;
      return isSignedIn() && (request.auth.uid == ev.ownerId || request.auth.uid in ev.get('coHostIds', []));
    }

    match /events/{eventId} {
      allow get: if true; // Public read for invitation view
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isHost(eventId);
    }

    match /guests/{guestId} {
      allow get: if true;
      allow list: if false; // Block bulk enumeration of guest personal data
      allow create: if true; // Allow guest RSVPs
      allow update, delete: if isHost(resource.data.eventId);
    }

    match /timeline/{itemId} {
      allow read: if true;
      allow write: if isHost(resource.data.eventId);
    }

    match /tasks/{taskId} {
      allow read, write: if isHost(resource.data.eventId);
    }

    match /budget/{itemId} {
      allow read, write: if isHost(resource.data.eventId);
    }

    match /shopping/{itemId} {
      allow read: if true;
      allow write: if isHost(resource.data.eventId);
    }
  }
}
