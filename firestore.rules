rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Events Collection: Anyone can read single event for public invites, but list is restricted
    match /events/{eventId} {
      allow get: if true; // Public read for invitation details
      allow list: if isSignedIn(); // Restricted list for authenticated hosts
      allow create: if true;
      allow update, delete: if true;
    }

    // Guests Collection (RSVPs)
    match /guests/{guestId} {
      allow get: if true;
      allow list: if true; // Allow real-time guest list lookup for active event
      allow create, update: if true; // Allow guest 1-click RSVPs without login
      allow delete: if true;
    }

    // Timeline, Tasks, Budget, Shopping Collections
    match /timeline/{itemId} {
      allow read, write: if true;
    }

    match /tasks/{taskId} {
      allow read, write: if true;
    }

    match /budget/{itemId} {
      allow read, write: if true;
    }

    match /shopping/{itemId} {
      allow read, write: if true;
    }
  }
}
